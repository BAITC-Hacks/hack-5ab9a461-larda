# Copy to .env; never commit your real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# openai calls the API; fallback is a labeled local demo with no network calls.
AI_MODE=openai
AI_TIMEOUT=60s
HTTP_ADDR=:8080
HTTP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=larda
POSTGRES_USER=larda
POSTGRES_PASSWORD=larda
# For running go run locally. Compose supplies the container hostname instead.
DATABASE_URL=postgres://larda:larda@localhost:5432/larda?sslmode=disable
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://127.0.0.1:4175
# Compose also supplies WEB_ORIGINS from WEB_PORT plus the Vite origins on 5173.
# It is merged with CORS_ORIGINS; changing WEB_PORT does not require copying CORS values.

# Frontend uses /api on its own origin; Vite proxies to this backend in development.
API_PROXY_TARGET=http://127.0.0.1:8080
VITE_DATA_MODE=server
WEB_PORT=3000
# Optional remote deployment override (no API keys here):
# VITE_API_BASE_URL=https://api.example.com
