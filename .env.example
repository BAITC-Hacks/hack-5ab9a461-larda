# Copy to .env; never commit your real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# openai calls the API; fallback is a labeled local demo with no network calls.
AI_MODE=openai
AI_TIMEOUT=60s
HTTP_ADDR=:8080
HTTP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=larda
POSTGRES_USER=larda
POSTGRES_PASSWORD=larda
# For running go run locally. Compose supplies the container hostname instead.
DATABASE_URL=postgres://larda:larda@localhost:5432/larda?sslmode=disable
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
